{
  "name": "branch-naming-standard",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "Branch naming standard",
        "negate": false,
        "operator": "regex",
        "pattern": "^(main|dev|((feat|fix|hotfix|refactor)\\/[0-9]+-[a-zA-Z0-9][a-zA-Z0-9._-]*)|(release|chore|docs|test|ci|build)\\/[a-zA-Z0-9][a-zA-Z0-9._-]*)\\n?$"
      }
    }
  ]
}
